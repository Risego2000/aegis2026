# ============================================================================
# AEGIS · OSINT Super App — configuración (copiar a .env)
# Todo lo que hay aquí es opcional: sin .env el sistema arranca con SQLite,
# motor de geovallas in-process y analista IA local determinista.
# ============================================================================

# --- HTTP ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- Almacenamiento -----------------------------------------------------
# Vacío  -> SQLite + R-Tree en ./data/osint.db (cero servicios, ideal portátil)
# PostGIS-> ruta de producción (docker-compose ya la levanta)
# DATABASE_URL=postgresql://osint:osint@localhost:5432/osint
RETENTION_DAYS=7

# --- Geovallado ---------------------------------------------------------
# Vacío -> motor in-process con semántica FENCE/DETECT idéntica
# TILE38_URL=tile38://localhost:9851

# --- Fuentes (todas gratuitas; las marcadas con clave son opcionales) ---
# --- fuentes gratuitas y sin clave (todas activas por defecto) ---
ENABLE_USGS=true
ENABLE_EONET=true          # NASA EONET: fuegos, tormentas, volcanes, hielo
ENABLE_EMSC=true           # sismos M2.5+ Europa/Mediterráneo
ENABLE_NWS=true            # avisos meteorológicos severos NOAA (EE.UU.)
ENABLE_ADSB_FI=true        # segundo agregador ADS-B (adsb.fi)
ENABLE_GDACS=true
ENABLE_GDELT=true
ENABLE_ADSB=true
ENABLE_AIS=true
ENABLE_FIRMS=true
ENABLE_SATELLITES=true

USGS_INTERVAL=120
GDACS_INTERVAL=300
GDELT_INTERVAL=900
ADSB_INTERVAL=20
# barrer todas las regiones en cada ciclo (movimiento continuo en el mapa)
ADSB_FULL_SWEEP=true
AIS_INTERVAL=60
FIRMS_INTERVAL=900
SAT_INTERVAL=5
USGS_FEED=4.5_day

# NASA FIRMS — funciona SIN clave: se descargan los CSV globales de 24 h
# (VIIRS NOAA-20 C2 + MODIS C6.1). FIRMS_MAP_KEY es OPCIONAL y solo mejora el
# recorte geográfico por /area (alta manual gratuita):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# aisstream.io — clave gratuita (AIS global por websocket):
# https://aisstream.io/ (registro con email)
AISSTREAM_API_KEY=
# Sin clave AIS, se usa el feed abierto keyless de Digitraffic (cobertura Báltico)
ENABLE_DIGITRAFFIC=true

ADSB_BASE=https://api.adsb.lol
CELESTRAK_GROUPS=stations,gps-ops,weather,geo,science,military,oneweb
# si CelesTrak bloquea la IP se usa el espejo público de GitHub; sin red, data/tle_cache.json

# --- IA (cero coste) ----------------------------------------------------
# auto -> Ollama local si está, si no Gemini Flash free tier, si no analista local
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
